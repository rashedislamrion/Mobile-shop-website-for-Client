# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and subpackages)
node_modules/
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
coverage/

# next.js & nestjs builds
/.next/
.next/
/out/
out/
/build
build/
dist/
api/dist/
**/dist/

# misc & OS
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# environment & secret files
.env
.env.*
!.env.example
!api/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (local dev fallback)
uploads/*
!uploads/.gitkeep
api/uploads/*
!api/uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# temp & scratch
scratch/
.system_generated/

