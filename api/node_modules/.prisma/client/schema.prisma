generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================= ENUMS =============================

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum PermissionScope {
  GLOBAL
  OWN_BRANCH
  OWN_DATA
}

enum ModuleName {
  DASHBOARD
  SALES
  CUSTOMERS
  ORDERS
  SALES_RETURNS
  EXCHANGES
  CATEGORY
  PRODUCTS
  BRANCH
  STOCK_ADJUSTMENTS
  HRM
  REPORT
  WALLET
  EXPENSE
  SUPPLIERS
  PURCHASE
  PROMOTIONAL_BANNER
  ADS
  PROMO_CODE
  PUSH_NOTIFICATION
  BLOGS
  HELP_REQUESTS
  HELP_NOTES
  BUSINESS_SETTINGS
  CMS
  THIRD_PARTY_CONFIG
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum StaffPaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_BANKING
}

enum BranchType {
  FLAGSHIP
  OUTLET
  WAREHOUSE
}

enum AddressTag {
  HOME
  OFFICE
  OTHER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum SaleType {
  POS
  COURIER
  DIAGNOSING
  WEBSITE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PARCEL_BOOKED
  DIAGNOSING
  DELIVERED
  RETURNED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  DUE
  REFUNDED
}

enum OrderPaymentMethod {
  BKASH
  SSLCOMMERZ
  COD
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum ExchangeStatus {
  REQUESTED
  APPROVED
  ITEM_RECEIVED
  COMPLETED
  REJECTED
}

enum ServiceJobStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
  RECOUNT
}

enum PayrollStatus {
  PAID
  PENDING
  PROCESSING
}

enum WalletKind {
  CASH
  BANK
  MOBILE_BANKING
}

enum WalletTxnType {
  DEPOSIT
  WITHDRAWAL
}

enum PurposeCategory {
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  PAID
  PENDING
}

enum SupplierPaymentTerm {
  COD
  NET_15
  NET_30
  NET_60
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

enum PromoApplicableTo {
  ALL
  CATEGORY
  PRODUCT
}

enum AdPlacement {
  HOMEPAGE_SIDEBAR
  CATEGORY_PAGE_TOP
  POPUP_ON_LOAD
  FOOTER_STRIP
}

enum PromoAdStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
}

enum NotificationTarget {
  ALL_CUSTOMERS
  CUSTOMERS_WITH_CART
  SEGMENT
}

enum NotificationStatus {
  SENT
  SCHEDULED
  DRAFT
  FAILED
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  SCHEDULED
}

enum MenuType {
  HEADER
  FOOTER_QUICK_LINKS
  FOOTER_SUPPORT
}

enum MenuLinkType {
  CATEGORY
  PRODUCT
  PAGE
  CUSTOM
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  WHATSAPP
  LINKEDIN
}

enum ContactSubmissionStatus {
  NEW
  READ
  REPLIED
}

enum IssueCategory {
  PRODUCT_ISSUE
  ORDER_ISSUE
  PAYMENT_ISSUE
  OTHER
}

enum TicketStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

enum SenderType {
  CUSTOMER
  STAFF
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentGatewayName {
  BKASH
  SSLCOMMERZ
  COD
}

enum MessageChannel {
  SMS
  EMAIL
}

// ============================= AUTH / STAFF / RBAC =============================

model Role {
  id                     String            @id @default(cuid())
  name                   String            @unique
  description            String?
  scope                  PermissionScope   @default(OWN_BRANCH)
  isSystem               Boolean           @default(false)
  staff                  Staff[]
  permissions            RolePermission[]
  autoAssignedIssueTypes TicketIssueType[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model RolePermission {
  id      String           @id @default(cuid())
  roleId  String
  role    Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  ModuleName
  action  PermissionAction
  allowed Boolean          @default(false)

  @@unique([roleId, module, action])
}

model Staff {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  name               String
  email              String               @unique
  phone              String               @unique
  passwordHash       String
  photo              String?
  gender             String?
  dob                DateTime?
  nidNumber          String?
  roleId             String
  role               Role                 @relation(fields: [roleId], references: [id])
  departmentId       String?
  department         Department?          @relation(fields: [departmentId], references: [id])
  branchId           String?
  branch             Branch?              @relation("BranchStaff", fields: [branchId], references: [id])
  employmentType     EmploymentType       @default(FULL_TIME)
  joiningDate        DateTime             @default(now())
  reportingManagerId String?
  reportingManager   Staff?               @relation("StaffReports", fields: [reportingManagerId], references: [id])
  reports            Staff[]              @relation("StaffReports")
  status             StaffStatus          @default(ACTIVE)
  basicSalary        Decimal              @default(0)
  allowances         Json?
  paymentMethod      StaffPaymentMethod?
  bankAccountNo      String?
  specializations    String[]
  managedBranches    Branch[]             @relation("BranchManager")
  headOfDepartments  Department[]         @relation("DepartmentHead")
  refreshTokens      RefreshToken[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  WastedProduct      WastedProduct[]
  Order              Order[]
  OrderStatusHistory OrderStatusHistory[]
  ServiceJob         ServiceJob[]
  StockAdjustment    StockAdjustment[]
  Payroll            Payroll[]
  WalletTransaction  WalletTransaction[]
  Expense            Expense[]
  SupplierPayment    SupplierPayment[]
  Blog               Blog[]
  SupportTicket      SupportTicket[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  staffId    String?
  staff      Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// ============================= CUSTOMER =============================

model Customer {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String          @unique
  passwordHash   String
  photo          String?
  emailVerified  Boolean         @default(false)
  phoneVerified  Boolean         @default(false)
  status         StaffStatus     @default(ACTIVE)
  addresses      Address[]
  orders         Order[]
  wishlist       Wishlist[]
  reviews        Review[]
  supportTickets SupportTicket[]
  refreshTokens  RefreshToken[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Address {
  id          String     @id @default(cuid())
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  email       String?
  fullAddress String
  tag         AddressTag @default(HOME)
  isDefault   Boolean    @default(false)
  orders      Order[]
  createdAt   DateTime   @default(now())
}

// ============================= BRANCH / DEPARTMENT =============================

model Branch {
  id                String            @id @default(cuid())
  name              String
  code              String            @unique
  type              BranchType        @default(OUTLET)
  address           String
  city              String
  phone             String
  altPhone          String?
  email             String?
  managerId         String?
  manager           Staff?            @relation("BranchManager", fields: [managerId], references: [id])
  status            StaffStatus       @default(ACTIVE)
  operatingHours    Json?
  openingStockValue Decimal           @default(0)
  taxRegNumber      String?
  showInFooter      Boolean           @default(true)
  staff             Staff[]           @relation("BranchStaff")
  orders            Order[]
  stockAdjustments  StockAdjustment[]
  wastedProducts    WastedProduct[]
  expenses          Expense[]
  purchaseOrders    PurchaseOrder[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Department {
  id     String      @id @default(cuid())
  name   String      @unique
  headId String?
  head   Staff?      @relation("DepartmentHead", fields: [headId], references: [id])
  status StaffStatus @default(ACTIVE)
  staff  Staff[]
}

// ============================= CATALOG =============================

model Category {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  parentId  String?
  parent    Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]  @relation("CategoryTree")
  icon      String?
  image     String?
  status    StaffStatus @default(ACTIVE)
  products  Product[]
  createdAt DateTime    @default(now())
}

model Brand {
  id       String      @id @default(cuid())
  name     String      @unique
  logo     String?
  status   StaffStatus @default(ACTIVE)
  series   Series[]
  products Product[]
}

model Series {
  id       String    @id @default(cuid())
  name     String
  brandId  String
  brand    Brand     @relation(fields: [brandId], references: [id])
  products Product[]
}

model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  shortCode String
  products  Product[]
}

model Attribute {
  id     String           @id @default(cuid())
  name   String           @unique
  values AttributeValue[]
}

model AttributeValue {
  id          String    @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
}

model Product {
  id                 String                 @id @default(cuid())
  name               String
  slug               String                 @unique
  shortDescription   String?
  description        String?
  categoryId         String
  category           Category               @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  seriesId           String?
  series             Series?                @relation(fields: [seriesId], references: [id])
  unitId             String?
  unit               Unit?                  @relation(fields: [unitId], references: [id])
  regularPrice       Decimal
  salePrice          Decimal?
  costPrice          Decimal?
  status             ProductStatus          @default(DRAFT)
  metaTitle          String?
  metaDescription    String?
  metaKeywords       String?
  images             ProductImage[]
  variants           ProductVariant[]
  specifications     ProductSpecification[]
  orderItems         OrderItem[]
  wishlist           Wishlist[]
  reviews            Review[]
  wastedProducts     WastedProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  StockAdjustment    StockAdjustment[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  color              String?
  quality            String?
  price              Decimal
  stock              Int                 @default(0)
  sku                String              @unique
  orderItems         OrderItem[]
  stockAdjustments   StockAdjustment[]
  wastedProducts     WastedProduct[]
  purchaseOrderItems PurchaseOrderItem[]
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
}

model WantedProduct {
  id            String   @id @default(cuid())
  productName   String
  customerName  String
  customerPhone String
  requestedDate DateTime @default(now())
  status        String   @default("NEW") // NEW SOURCING FULFILLED CANCELLED
  notes         String?
}

model WastedProduct {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  quantity     Int
  reason       String // DAMAGED EXPIRED LOST DEFECTIVE
  costImpact   Decimal
  reportedById String
  reportedBy   Staff           @relation(fields: [reportedById], references: [id])
  createdAt    DateTime        @default(now())
}

// ============================= ORDERS / SALES =============================

model Order {
  id                String               @id @default(cuid())
  orderCode         String               @unique
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id])
  branchId          String
  branch            Branch               @relation(fields: [branchId], references: [id])
  saleType          SaleType             @default(WEBSITE)
  status            OrderStatus          @default(PENDING)
  paymentStatus     PaymentStatus        @default(PENDING)
  paymentMethod     OrderPaymentMethod?
  subtotal          Decimal
  discountAmount    Decimal              @default(0)
  deliveryCharge    Decimal              @default(0)
  totalAmount       Decimal
  paidAmount        Decimal              @default(0)
  dueAmount         Decimal              @default(0)
  staffId           String?
  staff             Staff?               @relation(fields: [staffId], references: [id])
  shippingAddressId String?
  shippingAddress   Address?             @relation(fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  serviceJob        ServiceJob?
  shipment          Shipment?
  salesReturn       SalesReturn?
  exchange          Exchange?
  supportTickets    SupportTicket[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrderItem {
  id                  String            @id @default(cuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant?   @relation(fields: [variantId], references: [id])
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal
  lineTotal           Decimal
  salesReturnItems    SalesReturnItem[]
  exchange            Exchange?         @relation("OldOrderItem")
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   Staff?      @relation(fields: [changedById], references: [id])
  createdAt   DateTime    @default(now())
}

model SalesReturn {
  id           String            @id @default(cuid())
  returnCode   String            @unique
  orderId      String            @unique
  order        Order             @relation(fields: [orderId], references: [id])
  branchId     String
  reason       String
  refundAmount Decimal
  status       ReturnStatus      @default(REQUESTED)
  items        SalesReturnItem[]
  createdAt    DateTime          @default(now())
}

model SalesReturnItem {
  id            String      @id @default(cuid())
  salesReturnId String
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id])
  quantity      Int
}

model Exchange {
  id              String         @id @default(cuid())
  exchangeCode    String         @unique
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id])
  oldOrderItemId  String         @unique
  oldOrderItem    OrderItem      @relation("OldOrderItem", fields: [oldOrderItemId], references: [id])
  newProductId    String
  newVariantId    String?
  priceDifference Decimal
  status          ExchangeStatus @default(REQUESTED)
  createdAt       DateTime       @default(now())
}

model ServiceJob {
  id               String           @id @default(cuid())
  orderId          String           @unique
  order            Order            @relation(fields: [orderId], references: [id])
  technicianId     String?
  technician       Staff?           @relation(fields: [technicianId], references: [id])
  device           String
  issueDescription String
  specialization   String?
  serviceCharge    Decimal
  status           ServiceJobStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  courierPartner String
  trackingNo     String         @unique
  status         ShipmentStatus @default(PENDING_PICKUP)
  address        String
  lastUpdated    DateTime       @updatedAt
}

model StockAdjustment {
  id             String              @id @default(cuid())
  referenceNo    String              @unique
  productId      String
  product        Product             @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant?     @relation(fields: [variantId], references: [id])
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id])
  type           StockAdjustmentType
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  reason         String
  notes          String?
  adjustedById   String
  adjustedBy     Staff               @relation(fields: [adjustedById], references: [id])
  createdAt      DateTime            @default(now())
}

// ============================= HRM =============================

model Payroll {
  id            String              @id @default(cuid())
  staffId       String
  staff         Staff               @relation(fields: [staffId], references: [id])
  month         DateTime
  basicSalary   Decimal
  allowances    Json?
  deductions    Json?
  netSalary     Decimal
  status        PayrollStatus       @default(PENDING)
  paymentDate   DateTime?
  paymentMethod StaffPaymentMethod?
  createdAt     DateTime            @default(now())

  @@unique([staffId, month])
}

// ============================= ACCOUNTING =============================

model WalletType {
  id               String              @id @default(cuid())
  name             String
  kind             WalletKind
  currentBalance   Decimal             @default(0)
  status           StaffStatus         @default(ACTIVE)
  transactions     WalletTransaction[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]
}

model WalletTransaction {
  id           String        @id @default(cuid())
  walletTypeId String
  walletType   WalletType    @relation(fields: [walletTypeId], references: [id])
  type         WalletTxnType
  amount       Decimal
  purposeId    String?
  purpose      Purpose?      @relation(fields: [purposeId], references: [id])
  referenceNo  String        @unique
  note         String?
  recordedById String
  recordedBy   Staff         @relation(fields: [recordedById], references: [id])
  balanceAfter Decimal
  createdAt    DateTime      @default(now())
}

model Purpose {
  id           String              @id @default(cuid())
  name         String              @unique
  category     PurposeCategory
  transactions WalletTransaction[]
}

model ExpenseCategory {
  id            String    @id @default(cuid())
  name          String    @unique
  icon          String?
  monthlyBudget Decimal?
  expenses      Expense[]
}

model Expense {
  id            String          @id @default(cuid())
  referenceNo   String          @unique
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  description   String
  amount        Decimal
  walletTypeId  String
  walletType    WalletType      @relation(fields: [walletTypeId], references: [id])
  status        ExpenseStatus   @default(PENDING)
  attachmentUrl String?
  recordedById  String
  recordedBy    Staff           @relation(fields: [recordedById], references: [id])
  createdAt     DateTime        @default(now())
}

model Supplier {
  id               String              @id @default(cuid())
  name             String
  logo             String?
  contactPerson    String
  phone            String
  email            String?
  address          String
  productsSupplied String[]
  paymentTerms     SupplierPaymentTerm @default(COD)
  totalDue         Decimal             @default(0)
  status           StaffStatus         @default(ACTIVE)
  payments         SupplierPayment[]
  purchaseOrders   PurchaseOrder[]
  createdAt        DateTime            @default(now())
}

model SupplierPayment {
  id              String         @id @default(cuid())
  referenceNo     String         @unique
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  amount          Decimal
  method          String
  walletTypeId    String
  walletType      WalletType     @relation(fields: [walletTypeId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  note            String?
  recordedById    String
  recordedBy      Staff          @relation(fields: [recordedById], references: [id])
  createdAt       DateTime       @default(now())
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  branchId             String
  branch               Branch              @relation(fields: [branchId], references: [id])
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal
  discount             Decimal             @default(0)
  shippingCost         Decimal             @default(0)
  tax                  Decimal             @default(0)
  grandTotal           Decimal
  amountPaid           Decimal             @default(0)
  dueAmount            Decimal             @default(0)
  items                PurchaseOrderItem[]
  payments             SupplierPayment[]
  createdAt            DateTime            @default(now())
}

model PurchaseOrderItem {
  id               String          @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int             @default(0)
  unitCost         Decimal
  lineTotal        Decimal
}

// ============================= MARKETING =============================

model Banner {
  id        String      @id @default(cuid())
  imageUrl  String
  title     String?
  linkUrl   String
  sortOrder Int         @default(0)
  startDate DateTime?
  endDate   DateTime?
  status    StaffStatus @default(ACTIVE)
}

model Ad {
  id          String        @id @default(cuid())
  imageUrl    String
  title       String
  description String?
  placement   AdPlacement
  linkUrl     String
  impressions Int           @default(0)
  clicks      Int           @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      PromoAdStatus @default(ACTIVE)
}

model PromoCode {
  id                   String            @id @default(cuid())
  code                 String            @unique
  discountType         PromoDiscountType
  discountValue        Decimal
  maxDiscountCap       Decimal?
  minOrderAmount       Decimal?
  usageLimit           Int?
  usedCount            Int               @default(0)
  perCustomerLimit     Int?
  applicableTo         PromoApplicableTo @default(ALL)
  applicableCategoryId String?
  applicableProductIds String[]
  validFrom            DateTime
  validUntil           DateTime
  status               PromoAdStatus     @default(ACTIVE)
}

model PushNotification {
  id             String             @id @default(cuid())
  title          String
  message        String
  targetAudience NotificationTarget @default(ALL_CUSTOMERS)
  linkUrl        String?
  scheduledAt    DateTime?
  status         NotificationStatus @default(DRAFT)
  deliveredCount Int?
  createdAt      DateTime           @default(now())
}

model Blog {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String
  content         String
  featuredImage   String?
  authorId        String?
  author          Staff?        @relation(fields: [authorId], references: [id])
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  views           Int           @default(0)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  categoryTags    String[]
  createdAt       DateTime      @default(now())
}

// ============================= CMS =============================

model Page {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  content         String
  status          ContentStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  isSystem        Boolean       @default(false)
  updatedAt       DateTime      @updatedAt
}

model MenuItem {
  id           String       @id @default(cuid())
  menuType     MenuType
  label        String
  linkType     MenuLinkType
  linkValue    String
  openInNewTab Boolean      @default(false)
  sortOrder    Int          @default(0)
  status       StaffStatus  @default(ACTIVE)
}

model FooterSettings {
  id            String   @id @default(cuid())
  supportPhone  String
  supportEmail  String
  liveChatLink  String?
  faqLink       String?
  copyrightText String
  updatedAt     DateTime @updatedAt
}

model Country {
  id       String      @id @default(cuid())
  name     String      @unique
  code     String
  currency String
  status   StaffStatus @default(ACTIVE)
}

model SocialLink {
  id       String         @id @default(cuid())
  platform SocialPlatform @unique
  url      String
  status   StaffStatus    @default(ACTIVE)
}

model ContactSubmission {
  id        String                  @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  status    ContactSubmissionStatus @default(NEW)
  createdAt DateTime                @default(now())
}

model TicketIssueType {
  id               String          @id @default(cuid())
  name             String          @unique
  category         IssueCategory
  autoAssignRoleId String?
  autoAssignRole   Role?           @relation(fields: [autoAssignRoleId], references: [id])
  status           StaffStatus     @default(ACTIVE)
  tickets          SupportTicket[]
}

model SupportTicket {
  id           String                 @id @default(cuid())
  ticketCode   String                 @unique
  customerId   String
  customer     Customer               @relation(fields: [customerId], references: [id])
  orderId      String?
  order        Order?                 @relation(fields: [orderId], references: [id])
  issueTypeId  String
  issueType    TicketIssueType        @relation(fields: [issueTypeId], references: [id])
  subject      String
  description  String
  status       TicketStatus           @default(RUNNING)
  assignedToId String?
  assignedTo   Staff?                 @relation(fields: [assignedToId], references: [id])
  messages     SupportTicketMessage[]
  createdAt    DateTime               @default(now())
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType SenderType
  senderId   String
  message    String
  createdAt  DateTime      @default(now())
}

model HelpNote {
  id        String   @id @default(cuid())
  name      String
  phone     String
  subject   String
  note      String?
  createdAt DateTime @default(now())
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model Review {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
}

// ============================= SETTINGS / 3RD PARTY =============================

model BusinessSetting {
  id            String   @id @default(cuid())
  general       Json
  branding      Json
  currencyTax   Json
  orderSettings Json
  notifications Json
  updatedAt     DateTime @updatedAt
}

model PaymentGatewayConfig {
  id          String             @id @default(cuid())
  gateway     PaymentGatewayName @unique
  isActive    Boolean            @default(false)
  mode        String             @default("Test")
  credentials Json
  title       String
  logoUrl     String?
  extraConfig Json?
  updatedAt   DateTime           @updatedAt
}

model SmsConfig {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(false)
  provider  String
  apiKey    String?
  senderId  String?
  apiSecret String?
  updatedAt DateTime @updatedAt
}

model MailConfig {
  id         String   @id @default(cuid())
  isActive   Boolean  @default(false)
  driver     String   @default("SMTP")
  host       String?
  port       Int?
  username   String?
  password   String?
  encryption String?
  fromName   String?
  fromEmail  String?
  updatedAt  DateTime @updatedAt
}

model FirebaseConfig {
  id            String   @id @default(cuid())
  isActive      Boolean  @default(false)
  projectId     String?
  serverKey     String?
  senderId      String?
  configFileUrl String?
  updatedAt     DateTime @updatedAt
}

model RecaptchaConfig {
  id                String   @id @default(cuid())
  isActive          Boolean  @default(false)
  version           String   @default("v2")
  minScoreThreshold Float?
  siteKey           String?
  secretKey         String?
  appliesTo         String[]
  updatedAt         DateTime @updatedAt
}

model MessageTemplate {
  id        String         @id @default(cuid())
  channel   MessageChannel
  eventKey  String
  subject   String?
  body      String
  updatedAt DateTime       @updatedAt

  @@unique([channel, eventKey])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  userType  String // 'STAFF' or 'CUSTOMER'
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
